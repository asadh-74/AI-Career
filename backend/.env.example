# Run setup_local.py to create your actual .env with a password hash and session secret.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/career_atlas

# Career Atlas Automation
AUTO_APPLY=false
MIN_MATCH_SCORE=72
MAX_APPLICATIONS_PER_DAY=15
REMOTE_ONLY=true
ALLOW_EMAIL_APPLICATIONS=true
ALLOW_BROWSER_APPLICATIONS=true
ALLOW_INDEED=true
ALLOW_GLASSDOOR=true
AUTO_SUBMIT_BROWSER=false

# Store verified facts only. Never put secrets in this JSON.
APPLICANT_PROFILE_JSON={"name":"","email":"","phone":"","location":"","linkedin":"","github":"","portfolio":""}

# Optional SMTP route for job posts that request email applications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
